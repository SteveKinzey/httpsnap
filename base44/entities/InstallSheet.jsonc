{
  "name": "InstallSheet",
  "type": "object",
  "properties": {
    "spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet id that download clicks are appended to."
    },
    "spreadsheet_url": {
      "type": "string",
      "description": "Link to the download log spreadsheet."
    },
    "title": {
      "type": "string",
      "description": "Spreadsheet title as created in Google Drive."
    }
  },
  "required": [
    "spreadsheet_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}